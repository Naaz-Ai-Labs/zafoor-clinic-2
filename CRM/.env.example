# Postgres connection. The public website (../website) MUST point at this
# same database — that's how a website booking shows up in the CRM instantly,
# with no sync job. See ../website/.env.example.
#
# DATABASE_URL = Supabase's pooled connection (port 6543, ?pgbouncer=true).
# Required on Vercel/serverless - a direct connection exhausts fast when
# every function invocation opens a new one.
# DIRECT_URL = Supabase's direct connection (port 5432). Prisma needs this
# unpooled one for `prisma migrate`/`prisma db push` (pgbouncer can't run
# those). Local dev without Supabase can point both at the same local DB.
DATABASE_URL="postgresql://zafoor:zafoor_password@localhost:5432/zafoor_clinic"
DIRECT_URL="postgresql://zafoor:zafoor_password@localhost:5432/zafoor_clinic"

# Supabase Project Configuration
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

# Optional notification keys
EMAIL_API_KEY=""
SMS_API_KEY=""
